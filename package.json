{
  "name": "medovukhalauncher",
  "version": "2.3.2",
  "productName": "Medovukha Launcher",
  "description": "Modded Minecraft Launcher",
  "author": "BayerG (https://github.com/bayergg/)",
  "license": "UNLICENSED",
  "homepage": "https://github.com/bayergg/MedovukhaLauncher",
  "bugs": {
    "url": "https://github.com/bayergg/MedovukhaLauncher/issues"
  },
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "npm run build:helios-core",
    "prestart": "npm run build:helios-core",
    "start": "electron .",
    "clean:helios-core": "rimraf vendor/helios-core/dist",
    "build:helios-core": "npm run clean:helios-core && tsc -p vendor/helios-core/tsconfig.json",
    "predist": "npm run build:helios-core",
    "dist": "electron-builder build",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l",
    "lint": "eslint --config .eslintrc.json ."
  },
  "engines": {
    "node": "20.x.x"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "adm-zip": "^0.5.16",
    "discord-rpc-patch": "^4.0.1",
    "ejs": "^3.1.10",
    "ejs-electron": "^3.0.0",
    "electron-updater": "^6.3.9",
    "fs-extra": "^11.1.1",
    "github-syntax-dark": "^0.5.0",
    "fastq": "^1.19.0",
    "got": "^11.8.5",
    "helios-distribution-types": "^1.3.0",
    "jquery": "^3.7.1",
    "lodash.merge": "^4.6.2",
    "luxon": "^3.5.0",
    "node-stream-zip": "^1.15.0",
    "semver": "^7.6.3",
    "tar-fs": "^3.0.8",
    "toml": "^3.0.0",
    "triple-beam": "^1.4.1",
    "winreg": "^1.2.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.17.19",
    "@types/semver": "^7.5.8",
    "@types/tar-fs": "^2.0.4",
    "@types/triple-beam": "^1.3.5",
    "@types/winreg": "^1.2.36",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayergg/MedovukhaLauncher.git"
  }
}
